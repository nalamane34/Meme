# Caddy will auto-issue a Let's Encrypt cert for $DOMAIN as long as
# the domain's DNS A record points at this box and ports 80+443 are open.
#
# DOMAIN is required. Set it in .env (e.g. memebot.duckdns.org).
{$DOMAIN} {
    encode zstd gzip

    @webhooks path /webhooks/*
    handle @webhooks {
        reverse_proxy app:8000
    }

    @admin path /admin/*
    handle @admin {
        # Tighten this: only allow admin from your laptop's IP.
        # Replace 1.2.3.4 with your home/office egress IP, or
        # delete this block once you've added an auth layer.
        # @trusted client_ip 1.2.3.4
        # handle @trusted {
        reverse_proxy app:8000
        # }
        # respond 403
    }

    handle {
        reverse_proxy app:8000
    }

    log {
        output stdout
        format json
    }
}
