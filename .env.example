# --- Solana ---
WALLET_PRIVATE_KEY=                # base58-encoded 64-byte secret key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Helius ---
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=             # shared secret for verifying inbound webhooks

# --- Data providers ---
BIRDEYE_API_KEY=                   # optional, free tier works without
DEXSCREENER_BASE_URL=https://api.dexscreener.com

# --- Storage ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meme
REDIS_URL=redis://localhost:6379/0

# --- Trading ---
DRY_RUN=true                       # set false ONLY after shadow trading looks good
STRATEGY=rule_based                # rule_based | ppo
MODEL_PATH=models/ppo_latest.zip   # used when STRATEGY=ppo

MAX_POSITION_USD=50
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_USD=100
SLIPPAGE_BPS=300                   # 3% — memes need wide slippage
PRIORITY_FEE_MICROLAMPORTS=50000

STOP_LOSS_PCT=0.25                 # exit at -25%
TAKE_PROFIT_PCT=2.0                # +200%
TRAILING_STOP_PCT=0.35             # give back at most 35% from peak

# --- Discovery (autonomous candidate scanners) ---
DISCOVERY_ENABLED=true
DISCOVERY_DEX_BOOSTS_INTERVAL_SEC=180
DISCOVERY_DEX_PROFILES_INTERVAL_SEC=300
DISCOVERY_BIRDEYE_INTERVAL_SEC=600
DISCOVERY_PUMPFUN_INTERVAL_SEC=120
DISCOVERY_WALLET_FINDER_INTERVAL_SEC=3600

# --- Service ---
LOG_LEVEL=INFO
PORT=8000
